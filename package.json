{
  "name": "oovz-plugin-marketplace-tooling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/generate.mjs build",
    "check:generated": "node scripts/generate.mjs check --all",
    "generate": "node scripts/generate.mjs generate",
    "install:plugin": "node scripts/install.mjs",
    "test": "node scripts/test.mjs",
    "validate": "node scripts/validate.mjs",
    "verify": "npm run validate && npm run check:generated && npm test && npm run build -- --all",
    "test:sew": "node --test test/sew-cli.test.mjs",
    "pack:sew": "npm run bundle:sew && node scripts/pack-sew.mjs",
    "bundle:sew": "node scripts/generate.mjs build --plugin senior-engineering-workflow && node scripts/build-sew-package.mjs && node scripts/finalize-sew-package.mjs",
    "pretest": "npm run bundle:sew",
    "pretest:sew": "npm run bundle:sew"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "smol-toml": "^1.7.0",
    "yaml": "^2.9.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
