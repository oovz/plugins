{
  "$schema": "../../schemas/plugin.schema.json",
  "schemaVersion": 1,
  "id": "senior-engineering-workflow",
  "version": "0.11.0",
  "displayName": "Senior Engineering Workflow",
  "description": "A proportional engineering workflow in which the capable main agent owns decisions and bounded specialists isolate research, implementation, verification, and noisy tool work.",
  "license": "MIT",
  "author": {
    "name": "Otto",
    "url": "https://github.com/oovz/plugins"
  },
  "keywords": [
    "engineering",
    "coding",
    "research",
    "planning",
    "multi-agent",
    "verification",
    "context-isolation",
    "workflow"
  ],
  "category": "Productivity",
  "validation": {
    "profile": "engineering-delivery-v2",
    "contract": "skills/senior-engineering-workflow/references/workflow-contract.yaml",
    "evals": "evals/workflow-routing.yaml"
  },
  "components": {
    "skills": [
      {
        "id": "senior-engineering-workflow",
        "path": "skills/senior-engineering-workflow/SKILL.md"
      }
    ],
    "agents": [
      {
        "id": "researcher",
        "path": "agents/researcher.md",
        "description": "Answers bounded repository, runtime, and external-documentation questions with evidence and explicit uncertainty.",
        "workspace": "read-only",
        "shell": true,
        "external": true,
        "delegates": false,
        "question": false,
        "model": {
          "policy": "inherit"
        },
        "steps": null,
        "permissionPolicy": "inherit"
      },
      {
        "id": "engineer",
        "path": "agents/engineer.md",
        "description": "Implements one bounded production or test slice with immediate coverage and observed focused validation.",
        "workspace": "workspace-write",
        "shell": true,
        "external": false,
        "delegates": false,
        "question": false,
        "model": {
          "policy": "inherit"
        },
        "steps": null,
        "permissionPolicy": "inherit"
      },
      {
        "id": "verifier",
        "path": "agents/verifier.md",
        "description": "Independently verifies, reviews, or closes an accepted candidate without modifying production or test files.",
        "workspace": "read-only",
        "shell": true,
        "external": false,
        "delegates": false,
        "question": false,
        "model": {
          "policy": "inherit"
        },
        "steps": null,
        "permissionPolicy": "inherit"
      },
      {
        "id": "worker",
        "path": "agents/worker.md",
        "description": "Runs one bounded, tool-heavy repository, shell, or MCP operation and returns compact evidence instead of raw output.",
        "workspace": "workspace-write",
        "shell": true,
        "external": true,
        "delegates": false,
        "question": false,
        "model": {
          "policy": "inherit"
        },
        "steps": null,
        "permissionPolicy": "inherit"
      }
    ],
    "commands": []
  },
  "hosts": {
    "claude-code": {
      "enabled": true
    },
    "codex": {
      "enabled": true,
      "capabilities": [
        "Read",
        "Write"
      ]
    },
    "gemini-cli": {
      "enabled": true
    },
    "antigravity": {
      "enabled": true
    },
    "oh-my-pi": {
      "enabled": true
    },
    "opencode": {
      "enabled": true
    },
    "cursor": {
      "enabled": true
    }
  }
}
