{
  "$schema": "../../schemas/plugin-manifest.schema.json",
  "schemaVersion": 2,
  "id": "senior-engineering-workflow",
  "version": "0.14.0",
  "displayName": "Senior Engineering Workflow",
  "description": "Direct engineering ownership with optional research, implementation, and independent verification specialists.",
  "license": "MIT",
  "author": {
    "name": "Otto",
    "url": "https://github.com/oovz/plugins"
  },
  "keywords": [
    "engineering",
    "coding",
    "research",
    "planning",
    "multi-agent",
    "verification",
    "workflow"
  ],
  "category": "Productivity",
  "validation": {
    "profile": "engineering-delivery-v3",
    "contract": "evals/workflow-contract.yaml",
    "evals": "evals/workflow-routing.yaml"
  },
  "components": {
    "skills": [
      "senior-engineering-workflow"
    ],
    "agents": [
      {
        "id": "researcher",
        "path": "agents/researcher.md",
        "description": "Investigates a bounded question using repository, runtime, and primary-source evidence.",
        "workspace": "read-only",
        "shell": true,
        "external": true,
        "delegates": false,
        "question": false,
        "model": {
          "policy": "inherit"
        },
        "steps": null,
        "permissionPolicy": "inherit"
      },
      {
        "id": "engineer",
        "path": "agents/engineer.md",
        "description": "Implements and tests an independently owned slice with settled interfaces and acceptance criteria.",
        "workspace": "workspace-write",
        "shell": true,
        "external": false,
        "delegates": false,
        "question": false,
        "model": {
          "policy": "inherit"
        },
        "steps": null,
        "permissionPolicy": "inherit"
      },
      {
        "id": "verifier",
        "path": "agents/verifier.md",
        "description": "Independently challenges a design or candidate using acceptance checks and evidence-backed findings.",
        "workspace": "read-only",
        "shell": true,
        "external": false,
        "delegates": false,
        "question": false,
        "model": {
          "policy": "inherit"
        },
        "steps": null,
        "permissionPolicy": "inherit"
      }
    ],
    "commands": []
  },
  "hosts": {
    "claude-code": {
      "enabled": true
    },
    "codex": {
      "enabled": true,
      "capabilities": [
        "Read",
        "Write"
      ]
    },
    "gemini-cli": {
      "enabled": true
    },
    "antigravity": {
      "enabled": true
    },
    "oh-my-pi": {
      "enabled": true
    },
    "opencode": {
      "enabled": true
    },
    "cursor": {
      "enabled": true
    }
  }
}
