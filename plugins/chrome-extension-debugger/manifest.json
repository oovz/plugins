{
  "$schema": "../../schemas/plugin-manifest.schema.json",
  "schemaVersion": 2,
  "id": "chrome-extension-debugger",
  "version": "0.2.0",
  "displayName": "Chrome Extension Debugger",
  "shortDescription": "Develop and debug Chrome extensions in a live browser.",
  "description": "Develop and debug Chrome extensions in a live browser, with guidance for unpacked builds, extension surfaces, service workers, and WXT hot reload.",
  "license": "MIT",
  "author": {
    "name": "Otto",
    "url": "https://github.com/oovz/plugins"
  },
  "keywords": [
    "chrome-extension",
    "chrome-devtools",
    "mcp",
    "side-panel",
    "wxt",
    "debugging"
  ],
  "category": "Developer Tools",
  "components": {
    "skills": [
      "chrome-extension-debug",
      "wxt-extension-debug"
    ],
    "agents": [],
    "commands": [],
    "hostFiles": [
      {
        "id": "codex-mcp",
        "path": "codex.mcp.json",
        "destination": ".mcp.json",
        "hosts": [
          "codex"
        ]
      }
    ]
  },
  "hosts": {
    "claude-code": {
      "enabled": true
    },
    "codex": {
      "enabled": true,
      "capabilities": [
        "Read",
        "Write",
        "Execute"
      ]
    },
    "gemini-cli": {
      "enabled": true
    },
    "antigravity": {
      "enabled": true
    },
    "oh-my-pi": {
      "enabled": true
    },
    "opencode": {
      "enabled": true
    },
    "portable": {
      "enabled": true
    },
    "cursor": {
      "enabled": true
    }
  }
}
