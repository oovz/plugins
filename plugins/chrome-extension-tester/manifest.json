{
  "$schema": "../../schemas/plugin-manifest.schema.json",
  "schemaVersion": 2,
  "id": "chrome-extension-tester",
  "version": "0.1.2",
  "displayName": "Chrome Extension Tester",
  "shortDescription": "Test and debug Chrome extensions with Chrome DevTools MCP.",
  "description": "Test and debug Chrome extensions in Chrome-managed contexts through Chrome DevTools MCP, with extra guidance for WXT projects.",
  "license": "MIT",
  "author": {
    "name": "Otto",
    "url": "https://github.com/oovz/plugins"
  },
  "keywords": [
    "chrome-extension",
    "chrome-devtools",
    "mcp",
    "side-panel",
    "wxt",
    "e2e",
    "testing"
  ],
  "category": "Developer Tools",
  "components": {
    "skills": [
      "chrome-extension-test",
      "wxt-extension-test"
    ],
    "agents": [],
    "commands": [],
    "hostFiles": [
      {
        "id": "codex-mcp",
        "path": "codex.mcp.json",
        "destination": ".mcp.json",
        "hosts": [
          "codex"
        ]
      }
    ]
  },
  "hosts": {
    "claude-code": {
      "enabled": true
    },
    "codex": {
      "enabled": true,
      "capabilities": [
        "Read",
        "Write",
        "Execute"
      ]
    },
    "gemini-cli": {
      "enabled": true
    },
    "antigravity": {
      "enabled": true
    },
    "oh-my-pi": {
      "enabled": true
    },
    "opencode": {
      "enabled": true
    },
    "portable": {
      "enabled": true
    },
    "cursor": {
      "enabled": true
    }
  }
}
