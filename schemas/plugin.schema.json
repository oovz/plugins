{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/oovz/plugins/main/schemas/plugin.schema.json",
  "title": "canonical plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "displayName",
    "description",
    "license",
    "author",
    "components",
    "hosts"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skills",
        "agents",
        "commands"
      ],
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileComponent"
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agent"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "hostFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hostFile"
          }
        }
      }
    },
    "hosts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "claude-code": {
          "$ref": "#/$defs/host"
        },
        "codex": {
          "$ref": "#/$defs/codexHost"
        },
        "gemini-cli": {
          "$ref": "#/$defs/host"
        },
        "antigravity": {
          "$ref": "#/$defs/host"
        },
        "opencode": {
          "$ref": "#/$defs/host"
        },
        "portable": {
          "$ref": "#/$defs/host"
        },
        "oh-my-pi": {
          "$ref": "#/$defs/host"
        },
        "cursor": {
          "$ref": "#/$defs/host"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "evals"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "$ref": "#/$defs/relativePath"
        },
        "evals": {
          "$ref": "#/$defs/relativePath"
        }
      }
    }
  },
  "$defs": {
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "stable",
            "preview",
            "experimental"
          ]
        }
      }
    },
    "codexHost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "stable",
            "preview",
            "experimental"
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\u0000-\\u001f\\u007f\\u0085\\u00ad\\u034f\\u061c\\u115f\\u1160\\u17b4\\u17b5\\u180b-\\u180e\\u200b\\u200c\\u200e\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2060-\\u206f\\ufeff]+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "capabilities"
            ]
          }
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "fileComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "description",
        "workspace",
        "shell",
        "external",
        "delegates",
        "question",
        "model",
        "steps"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "workspace": {
          "enum": [
            "read-only",
            "workspace-write"
          ]
        },
        "shell": {
          "type": "boolean"
        },
        "external": {
          "type": "boolean"
        },
        "delegates": {
          "type": "boolean"
        },
        "question": {
          "type": "boolean"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy"
          ],
          "properties": {
            "policy": {
              "const": "inherit"
            }
          }
        },
        "steps": {
          "type": "null"
        },
        "permissionPolicy": {
          "enum": [
            "explicit",
            "inherit"
          ],
          "default": "explicit"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "hosts"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "claude-code",
              "cursor",
              "gemini-cli",
              "opencode",
              "oh-my-pi"
            ]
          }
        }
      }
    },
    "hostFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "hosts",
        "destination"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "claude-code",
              "codex",
              "cursor",
              "gemini-cli",
              "antigravity",
              "opencode",
              "portable",
              "oh-my-pi"
            ]
          }
        },
        "destination": {
          "$ref": "#/$defs/relativePath"
        },
        "executable": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
