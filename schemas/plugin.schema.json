{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/oovz/plugins/main/schemas/plugin.schema.json",
  "title": "canonical plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "displayName", "description", "license", "author", "components", "hosts"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "keywords": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "category": { "type": "string", "minLength": 1 },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills", "agents", "commands"],
      "properties": {
        "skills": { "type": "array", "items": { "$ref": "#/$defs/fileComponent" } },
        "agents": { "type": "array", "items": { "$ref": "#/$defs/agent" } },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
        "hostFiles": { "type": "array", "items": { "$ref": "#/$defs/hostFile" } }
      }
    },
    "hosts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "enum": ["claude-code", "codex", "gemini-cli", "antigravity", "opencode", "opencode-v2", "portable"] },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled"],
        "properties": {
          "enabled": { "type": "boolean" },
          "status": { "enum": ["stable", "preview", "experimental"] }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "contract", "evals"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "contract": { "$ref": "#/$defs/relativePath" },
        "evals": { "$ref": "#/$defs/relativePath" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "fileComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "description", "workspace", "shell", "external", "delegates", "question", "model", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/relativePath" },
        "description": { "type": "string", "minLength": 1 },
        "workspace": { "enum": ["read-only", "workspace-write"] },
        "shell": { "type": "boolean" },
        "external": { "type": "boolean" },
        "delegates": { "type": "boolean" },
        "question": { "type": "boolean" },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "recommendedTier"],
          "properties": {
            "policy": { "const": "inherit" },
            "recommendedTier": { "enum": ["economy", "balanced", "deep"] }
          }
        },
        "steps": { "type": "null" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "hosts"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/relativePath" },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["claude-code", "gemini-cli", "opencode", "opencode-v2"] }
        }
      }
    },
    "hostFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "hosts", "destination"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/relativePath" },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["claude-code", "codex", "gemini-cli", "antigravity", "opencode", "opencode-v2", "portable"] }
        },
        "destination": { "$ref": "#/$defs/relativePath" },
        "executable": { "type": "boolean", "default": false }
      }
    }
  }
}
